# =================================================================
# AnnDwar - Environment Configuration Template
# =================================================================

# GEMINI_API_KEY: Required for Gemini Multimodal AI crop pre-check & assistant
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this application is hosted
APP_URL="http://localhost:5173"

# =================================================================
# PRODUCTION SMS & OTP GATEWAY PROVIDERS
# =================================================================
# AnnDwar supports live telecom gateways. All OTPs and lifecycle updates 
# (Gate entry, Call scale, Weighment, DBT Payment) are delivered exclusively
# to the exact mobile number registered by the farmer during signup.

# --- Option 1: Fast2SMS (Recommended for Indian Mobile Numbers) ---
# Sign up at https://www.fast2sms.com to get your API authorization key.
# Once set, OTPs and SMS notifications will be dispatched directly to Indian mobile networks.

FAST2SMS_API_KEY="your-fast2sms-api-key-here"

# --- Option 2: Twilio (SMS & WhatsApp Delivery) ---

# --- Option 3: MSG91 (Optional alternative SMS Gateway) ---

